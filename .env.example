# ==================================
# CivicPulse Configuration Template
# ==================================
# Copy this file to .env and fill in your actual values

NODE_ENV=production
PORT=5000

# MongoDB Atlas (Replace with your database connection string)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/civicpulse?retryWrites=true&w=majority

# JWT Configuration (Generate your own secure random string)
JWT_SECRET=your-super-secret-jwt-key-here-change-this
JWT_EXPIRE=7d

# Email Configuration (Gmail SMTP or other email service)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=CivicPulse <your-email@gmail.com>

# Frontend URL (Update for production domain)
FRONTEND_URL=http://localhost:4201

# Gemini AI Configuration (Get your API key from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here
